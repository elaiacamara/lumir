#version 450

struct IDsDist{
    ivec2 IDs;
    float dis;
};
struct IslandIdContinentID{
    ivec2 IDs;
};
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D img_render;
layout(rgba32i, binding = 1) uniform iimage2D img;
layout(std430, binding = 2) buffer CounterBuffer
{
    int counter;
};
layout(std430, binding = 3) buffer BufferIDDist
{
    IDsDist ids_dist[];
};
layout(std430, binding = 4) buffer Buffer
{
    IslandIdContinentID mapping[];
};

vec2 to_position(int packed){
    int x =  packed & 0xFFFF;
    int y = (packed >> 16) & 0xFFFF;
    return vec2(x, y);
}


vec3 heightToColor(float h)
{
    if (h < 0.5)
    {
        // Ocean
        float t = h / 0.5;
        return mix(vec3(0.0, 0.0, 0.3), vec3(0.0, 0.5, 1.0), t);
    }

    // Land remapped to 0..1
    float t = (h - 0.5) / 0.5;

    // Gradient steps
    vec3 beach  = vec3(0.9, 0.85, 0.5);  // yellow
    vec3 grass  = vec3(0.1, 0.6, 0.2);   // green
    vec3 dirt   = vec3(0.4, 0.3, 0.2);   // brown
    vec3 snow   = vec3(1.0);             // white

    if (t < 0.1)
    {
        // beach
        return mix(beach, grass, t / 0.6);
    }
    else if (t < 0.5)
    {
        // grass → dirt
        return mix(grass, dirt, (t - 0.15) / (0.5 - 0.15));
    }
    else
    {
        // dirt → snow
        return mix(dirt, snow, (t - 0.5) / 0.5);
    }
}

vec3 hsv2rgb(vec3 c)
{
    vec4 K = vec4(1.0, 2.0/3.0, 1.0/3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

vec3 randomColor(float v)
{
    float id = floor(v * 1000.0);

    float h = fract(sin(id) * 43758.5453);
    float s = 0.6 + 0.4 * fract(sin(id + 1.0) * 43758.5453);
    float l = 0.5 + 0.3 * fract(sin(id + 2.0) * 43758.5453);

    return hsv2rgb(vec3(h, s, l));
}

void main()
{   
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(img);
    if (coord.x >= size.x || coord.y >= size.y) return;
    ivec4 value = imageLoad(img, coord);
    
    vec3 color;
    if (value.y != -1){
        
        color = randomColor(value.y / 198.0);
        //color = vec3(0.0);
    }
    else{

        float len = length(vec2(coord) - to_position(value.z));
        if (len <= 1.6)
            color = vec3(0.0);
        else{
            ivec4 value = imageLoad(img, ivec2(to_position(value.z)));
            color = randomColor(value.z / 70.0);
        }
        //else{
        int debug = value.w;
        if (debug == 1)
            color = vec3(0.0,1.0,0.0);
        else if (debug == 2)
            color = vec3(0.0,0.0,1.0);
        //}
        /*
        int debug = value.w;
        if (debug == 0)
            color = vec3(0.0);
        else if (debug == 1)
            color = vec3(0.0,1.0,0.0);
        else if (debug == 2)
            color = vec3(0.0,0.0,1.0);
        */
    }
    //if (value.y == 0)
    //    color = vec3(1.0);
    imageStore(img_render, coord, vec4(color, 1.0));
}
